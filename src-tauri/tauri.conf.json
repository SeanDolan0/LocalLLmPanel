{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local LLM Panel",
  "version": "1.0.0",
  "identifier": "com.local-llm-panel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local LLM Panel",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Manage vLLM servers inside WSL2",
    "longDescription": "A native Windows app that provisions vLLM in WSL2, estimates and pulls any Hugging Face model, and runs multiple vLLM servers concurrently.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}